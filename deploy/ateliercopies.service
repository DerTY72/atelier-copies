[Unit]
Description=Atelier Copies Next.js application
After=network.target postgresql.service

[Service]
Type=simple
User=atelier
Group=atelier
WorkingDirectory=/var/www/ateliercopies/current
Environment=NODE_ENV=production
EnvironmentFile=/var/www/ateliercopies/shared/.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
