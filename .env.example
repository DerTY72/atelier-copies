DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/atelier_copies?schema=public"
AUTH_SECRET="replace-this-with-a-long-random-local-secret"
APP_URL="http://127.0.0.1:3000"

# В dev-режиме без SMTP письма сохраняются в storage/email-dev.log
MAIL_MODE="log"
MAIL_FROM="Atelier Copies <no-reply@example.com>"
MAIL_ADMIN_TO="admin@example.com"

# Для реальной отправки смените MAIL_MODE на smtp и заполните SMTP-настройки.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
